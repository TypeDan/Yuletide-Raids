-- Synchronized, player-scoped temporary buffs. No local UI state changes gameplay.
YULE_CHEER_DURATION = 30

function Yule_CheerBlueprints()
    if YULE.cheerBlueprints == nil then
        local blueprints={}
        local seen={}
        -- Villagers only: worker also includes traders and other economic units.
        for _,bp in pairs(BP_GetEntityBlueprintsWithType(AGS_BP_VILLAGER)) do
            local id=bp.PropertyBagGroupID
            if not seen[id] then seen[id]=true; table.insert(blueprints,bp) end
        end
        table.sort(blueprints,function(a,b) return a.PropertyBagGroupID<b.PropertyBagGroupID end)
        YULE.cheerBlueprints=blueprints
    end
    return YULE.cheerBlueprints
end

function Yule_CheerSecondsRemaining(player)
    local state=(YULE.cheers or {})[Yule_PlayerSlot(player)]
    if state == nil then return 0 end
    return math.max(0,math.ceil(state.expires-World_GetGameTime()))
end

function Yule_ClearCheer(slot)
    local state=(YULE.cheers or {})[slot]
    if state == nil then return end
    -- Own the full lifetime: player/entity-type modifiers must be explicitly
    -- removed, including when the displayed countdown has reached zero.
    Modifier_Remove(state.modifiers)
    YULE.cheers[slot]=nil
end

function Yule_ExpireCheer(context,data)
    local state=(YULE.cheers or {})[data.slot]
    -- A previous purchase's callback must not cancel a refreshed purchase.
    if state and state.expires==data.expires and World_GetGameTime()>=state.expires then
        Yule_ClearCheer(data.slot)
    end
end

function Yule_ApplyFestiveCheer(buyer)
    local blueprints=Yule_CheerBlueprints()
    if #blueprints==0 then return false end
    local modifiers={}
    local changes={
        {"speed_maximum_modifier",1.3},
        {"resource_entity_harvest_rate_food",1.5},
        {"resource_entity_harvest_rate_wood",1.5},
        {"resource_entity_harvest_rate_gold",1.5},
        {"resource_entity_harvest_rate_stone",1.5},
    }
    local ok=pcall(function()
        for _,bp in ipairs(blueprints) do
            for _,change in ipairs(changes) do
                local modifier=Modifier_Create(MAT_EntityType,change[1],MUT_Multiplication,false,change[2],bp)
                -- Duration 0 keeps native expiry from racing our cleanup.
                local id=Modifier_ApplyToPlayer(modifier,buyer.id,0)
                if id==nil then error("Festive Cheer modifier was not applied") end
                table.insert(modifiers,id)
            end
        end
    end)
    if not ok then
        Modifier_Remove(modifiers)
        return false
    end
    local slot=Yule_PlayerSlot(buyer.id)
    -- Replace the old set in the same simulation callback; never stack purchases.
    -- Only remove it after the replacement succeeds, so a failed refresh preserves it.
    Yule_ClearCheer(slot)
    YULE.cheers=YULE.cheers or {}
    YULE.cheers[slot]={player=buyer.id,expires=World_GetGameTime()+YULE_CHEER_DURATION,modifiers=modifiers}
    Rule_AddOneShot(Yule_ExpireCheer,YULE_CHEER_DURATION,{slot=slot,expires=YULE.cheers[slot].expires})
    return true
end

function Yule_UpdateCheer(players)
    local living={}
    for _,player in ipairs(players) do living[player.id]=true end
    -- Stable slot order, independent of each client's local player.
    for slot=1,8 do
        local state=(YULE.cheers or {})[slot]
        if state and (not living[state.player] or World_GetGameTime()>=state.expires) then
            Yule_ClearCheer(slot)
        end
    end
end

function Yule_ClearAllCheer()
    for slot=1,8 do Yule_ClearCheer(slot) end
end

-- Permanent, per-entity purchases. Store stable entity IDs in synchronized state.
function Yule_ChampionAlive(entry)
    if not Entity_IsValid(entry.id) then return false end
    local entity=Entity_FromID(entry.id)
    return Entity_IsAlive(entity) and not World_OwnsEntity(entity)
        and Entity_GetPlayerOwner(entity)==entry.player
end

function Yule_ChampionCount(player)
    local count=0
    for _,entry in ipairs(YULE.champions or {}) do
        if entry.player==player and Yule_ChampionAlive(entry) then count=count+1 end
    end
    return count
end

function Yule_CanBlessUnit(player,id)
    if not id or not Entity_IsValid(id) then return false end
    local entity=Entity_FromID(id)
    if not Entity_IsAlive(entity) or World_OwnsEntity(entity) or Entity_GetPlayerOwner(entity)~=player
        or not Entity_IsOfType(entity,AGS_BP_MILITARY) or Entity_IsOfType(entity,AGS_BP_BUILDING)
        or Entity_IsOfType(entity,AGS_BP_VILLAGER) then return false end
    for _,entry in ipairs(YULE.champions or {}) do if entry.id==id then return false end end
    return Yule_ChampionCount(player)<5
end

-- UI-only selection is converted to an ID and sent over the network. Never
-- query local selection in the simulation's purchase receiver.
function Yule_SelectedChampionTarget(player)
    local selected=nil
    local count=0
    EGroup_ForEach(Player_GetAllEntities(player),function(group,index,entity)
        if Entity_IsAlive(entity) and Misc_IsEntitySelected(entity) then
            count=count+1; selected=Entity_GetID(entity)
        end
    end)
    if count~=1 or not Yule_CanBlessUnit(player,selected) then return nil end
    return selected
end

function Yule_UpdateChampions()
    for i=#(YULE.champions or {}),1,-1 do
        local entry=YULE.champions[i]
        -- Conversion removes the blessing instead of transferring a sixth slot.
        if not Yule_ChampionAlive(entry) then
            if Entity_IsValid(entry.id) then Modifier_Remove(entry.modifiers) end
            table.remove(YULE.champions,i)
        end
    end
end

function Yule_BlessUnit(player,id)
    Yule_UpdateChampions()
    if not Yule_CanBlessUnit(player,id) then return false end
    local entity=Entity_FromID(id)
    local modifiers={}
    local ok=pcall(function()
        local function apply(scope,name,target)
            local mod=Modifier_Create(scope,name,MUT_Multiplication,false,1.2,target)
            local applied=Modifier_ApplyToEntity(mod,entity,0)
            if applied==nil then error("Winter Champion modifier failed") end
            table.insert(modifiers,applied)
        end
        apply(MAT_Entity,"speed_maximum_modifier",nil)
        apply(MAT_Entity,"armor_scalar_for_melee_damage",nil)
        apply(MAT_Entity,"armor_scalar_for_ranged_damage",nil)
        apply(MAT_Entity,"armor_scalar_for_fire_damage",nil)
        -- Include alternate melee, ranged and torch weapons, not just hardpoint 1.
        for hardpoint=1,Entity_GetWeaponHardpointCount(entity) do
            apply(MAT_Weapon,"damage_weapon_modifier",string.format("hardpoint_%02d",hardpoint))
        end
    end)
    if not ok then Modifier_Remove(modifiers); return false end
    YULE.champions=YULE.champions or {}
    table.insert(YULE.champions,{id=id,player=player,modifiers=modifiers})
    return true
end

function Yule_ClearChampions()
    for _,entry in ipairs(YULE.champions or {}) do
        if Entity_IsValid(entry.id) then Modifier_Remove(entry.modifiers) end
    end
    YULE.champions={}
end
