-- Invulnerable scripted convoy using native pathfinding and animation. Sight and population are zero.
-- All route choices and commands are simulation-owned.
YULE_REINDEER={"dasher","dancer","prancer","vixen","comet","cupid","donner","blitzen","rudolph"}
function Yule_ConvoyBlueprints()
    YULE.blueprints.reindeer={}
    for i,name in ipairs(YULE_REINDEER) do
        YULE.blueprints.reindeer[i]=Yule_ResolveBlueprint(BP_GetSquadBlueprint,"yule_"..name,1073742750+i,"sbps")
    end
end
function Yule_ConvoyBounds()
    return math.max(1,World_GetWidth()/2-24),math.max(1,World_GetLength()/2-24)
end
-- Sample the map independently of player positions, team sizes or lobby order.
function Yule_RandomMapPosition()
    local w,h=Yule_ConvoyBounds()
    for attempt=1,64 do
        local x=World_GetRand(-math.floor(w),math.floor(w))
        local z=World_GetRand(-math.floor(h),math.floor(h))
        if World_GetTerrainCellType(x,z)==1 then
            return World_Pos(x,World_GetHeightAt(x,z),z)
        end
    end
    return nil
end
function Yule_RandomWaypoint(origin)
    return Yule_RandomMapPosition() or origin
end
function Yule_ConvoyMember(owner,blueprint,name,position)
    local group=SGroup_CreateIfNotFound("yule_convoy_"..YULE.visits.."_"..name)
    UnitEntry_DeploySquads(owner,group,{{sbp=blueprint,numSquads=1}},position)
    SGroup_SetSelectable(group,false)
    AI_LockSquads(owner,group)
    SGroup_SetInvulnerable(group,true)
    return group
end
function Yule_StartVisit(players)
    if #players==0 then return false end
    local origin=Yule_RandomMapPosition()
    if origin==nil then return false end
    YULE.visits=YULE.visits+1
    -- A technical owner is needed for native movement; it grants no sight or control.
    local owner=players[1].id
    local group=Yule_ConvoyMember(owner,YULE.blueprints.santa,"santa",origin)
    origin=SGroup_GetPosition(group)
    local members={}
    for i,name in ipairs(YULE_REINDEER) do
        local row=math.floor((i-1)/2)
        members[i]={group=Yule_ConvoyMember(owner,YULE.blueprints.reindeer[i],name,origin),
            forward=i==9 and 12 or 4+row*2,side=i==9 and 0 or (i%2==1 and -1.5 or 1.5)}
    end
    YULE.santa={group=group,members=members,position=origin,destination=Yule_RandomWaypoint(origin),
        owner=owner, nextCommand=YULE.time+3, lastRoute=YULE.time,
        launchAt=YULE.time+3,ends=YULE.time+YULE_CONFIG.visitDuration,nextDrop=YULE.time+1,drops=0}
    Yule_Notify(2002)
    return true
end
function Yule_EndVisit()
    local santa=YULE.santa
    if santa==nil then return end
    for _,member in ipairs(santa.members or {}) do Yule_DestroyGroup(member.group) end
    Yule_DestroyGroup(santa.group)
    YULE.santa=nil
end
function Yule_IsConvoySquad(squad)
    local santa=YULE.santa
    if santa==nil then return false end
    local id=Squad_GetID(squad)
    if SGroup_ContainsSquad(santa.group,id,false) then return true end
    for _,member in ipairs(santa.members) do
        if SGroup_ContainsSquad(member.group,id,false) then return true end
    end
    return false
end
function Yule_Flight()
    local santa=YULE.santa
    if santa==nil or not YULE.running or SGroup_CountSpawned(santa.group)==0 then return end
    santa.position=SGroup_GetPosition(santa.group)
    if YULE.time<santa.nextCommand then return end
    santa.nextCommand=YULE.time+1
    local dx=santa.destination.x-santa.position.x
    local dz=santa.destination.z-santa.position.z
    local distance=math.sqrt(dx*dx+dz*dz)
    if distance<6 or YULE.time-santa.lastRoute>=10 then
        santa.destination=Yule_RandomWaypoint(santa.position)
        santa.lastRoute=YULE.time
        dx=santa.destination.x-santa.position.x;dz=santa.destination.z-santa.position.z
        distance=math.sqrt(dx*dx+dz*dz)
    end
    if distance<0.01 then return end
    dx=dx/distance;dz=dz/distance
    Cmd_Move(santa.group,santa.destination)
    local w,h=Yule_ConvoyBounds()
    for _,member in ipairs(santa.members) do
        local x=math.max(-w,math.min(w,santa.position.x+dx*(member.forward+20)-dz*member.side))
        local z=math.max(-h,math.min(h,santa.position.z+dz*(member.forward+20)+dx*member.side))
        if World_GetTerrainCellType(x,z)==1 then
            Cmd_Move(member.group,World_Pos(x,World_GetHeightAt(x,z),z))
        else
            Cmd_Move(member.group,santa.destination)
        end
    end
end
function Yule_DropAreaClear(position,players)
    if World_GetTerrainCellType(position.x,position.z)~=1 then return false end
    for _,present in ipairs(YULE.presents) do
        if (position.x-present.position.x)^2+(position.z-present.position.z)^2<144 then return false end
    end
    local nearby=EGroup_CreateIfNotFound("yule_drop_clearance")
    local blocked=false
    for _,player in ipairs(players) do
        EGroup_Clear(nearby)
        Player_GetAllEntitiesNearMarker(player.id,nearby,position,6)
        EGroup_ForEach(nearby,function(gid,idx,entity)
            if Entity_IsOfType(entity,AGS_BP_BUILDING) then blocked=true end
        end)
    end
    return not blocked
end
function Yule_UpdateVisit(players)
    local santa=YULE.santa
    if santa==nil then return end
    if YULE.time>=santa.ends or SGroup_CountSpawned(santa.group)==0 then Yule_EndVisit(); return end
    if YULE.time<santa.nextDrop then return end
    if santa.drops<YULE_CONFIG.giftsPerVisit then
        local position=Yule_PositionNear(santa.position,World_GetRand(2,6))
        if Yule_DropAreaClear(position,players) and Yule_DropPresent(position,players) then
            santa.drops=santa.drops+1
        end
    end
    santa.nextDrop=YULE.time+World_GetRand(2,4)
end
