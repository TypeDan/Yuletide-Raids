-- Invulnerable neutral convoy using native pathfinding and animation.
-- All route choices and commands are simulation-owned.
YULE_REINDEER={"dasher","dancer","prancer","vixen","comet","cupid","donner","blitzen","rudolph"}
function Yule_ConvoyBlueprints()
    YULE.blueprints.reindeer={}
    for i,name in ipairs(YULE_REINDEER) do
        YULE.blueprints.reindeer[i]=Yule_ResolveBlueprint(BP_GetSquadBlueprint,"yule_"..name,1073742750+i,"sbps")
    end
end
function Yule_ConvoyBounds()
    return math.max(1,World_GetWidth()/2-24),math.max(1,World_GetLength()/2-24)
end
-- Sample the map independently of player positions, team sizes or lobby order.
function Yule_RandomMapPosition()
    local w,h=Yule_ConvoyBounds()
    for attempt=1,64 do
        local x=World_GetRand(-math.floor(w),math.floor(w))
        local z=World_GetRand(-math.floor(h),math.floor(h))
        if World_GetTerrainCellType(x,z)==1 then
            return World_Pos(x,World_GetHeightAt(x,z),z)
        end
    end
    return nil
end
function Yule_RandomWaypoint(origin)
    return Yule_RandomMapPosition() or origin
end
function Yule_ConvoyMember(owner,blueprint,name,position,route,forward,side)
    local group=SGroup_CreateIfNotFound("yule_convoy_"..YULE.visits.."_"..name)
    UnitEntry_DeploySquads(owner,group,{{sbp=blueprint,numSquads=1}},position)
    -- Native Cmd_Move requires an issuer. Queue the whole route and relinquish
    -- ownership within this same simulation callback, before the next tick.
    -- Orders survive the transfer; the convoy stays world-owned for its visit.
    local previous=position
    local w,h=Yule_ConvoyBounds()
    for i,target in ipairs(route) do
        local destination=target
        if forward then
            local dx,dz=target.x-previous.x,target.z-previous.z
            local distance=math.sqrt(dx*dx+dz*dz)
            if distance>0.01 then
                dx=dx/distance;dz=dz/distance
                local x=math.max(-w,math.min(w,target.x+dx*forward-dz*side))
                local z=math.max(-h,math.min(h,target.z+dz*forward+dx*side))
                if World_GetTerrainCellType(x,z)==1 then destination=World_Pos(x,World_GetHeightAt(x,z),z) end
            end
        end
        Cmd_Move(group,destination,i>1)
        previous=target
    end
    SGroup_SetWorldOwned(group)
    SGroup_SetSelectable(group,false)
    SGroup_SetInvulnerable(group,true)
    return group
end
function Yule_SpawnConvoy(players,origin)
    local route={}
    local waypoint=origin
    for i=1,64 do waypoint=Yule_RandomWaypoint(waypoint);route[i]=waypoint end
    -- Used only to issue initial orders, never retained as the convoy's owner.
    local owner=players[1].id
    local group=Yule_ConvoyMember(owner,YULE.blueprints.santa,"santa",origin,route)
    origin=SGroup_GetPosition(group)
    local members={}
    for i,name in ipairs(YULE_REINDEER) do
        local row=math.floor((i-1)/2)
        local forward=i==9 and 12 or 4+row*2
        local side=i==9 and 0 or (i%2==1 and -1.5 or 1.5)
        members[i]={group=Yule_ConvoyMember(owner,YULE.blueprints.reindeer[i],name,origin,route,forward,side)}
    end
    return {group=group,members=members,position=origin,destination=route[1]}
end
function Yule_StartVisit(players)
    if #players==0 then return false end
    local capacity=YULE_CONFIG.maxPresents-#(YULE.presents or {})
    if capacity<YULE_CONFIG.minGiftsPerVisit then return false end
    local origin=Yule_FindDeliveryArea(players)
    if origin==nil then return false end
    YULE.visits=YULE.visits+1
    local convoy=Yule_SpawnConvoy(players,origin)
    YULE.santa={group=convoy.group,members=convoy.members,position=convoy.position,destination=convoy.destination,
        ends=YULE.time+YULE_CONFIG.visitDuration,nextDrop=YULE.time,drops=0,dropSites={},
        dropTarget=World_GetRand(YULE_CONFIG.minGiftsPerVisit,math.min(YULE_CONFIG.giftsPerVisit,capacity))}
    Yule_Notify(2002)
    return true
end
function Yule_EndVisit()
    local santa=YULE.santa
    if santa==nil then return end
    for _,member in ipairs(santa.members or {}) do Yule_DestroyGroup(member.group) end
    Yule_DestroyGroup(santa.group)
    YULE.santa=nil
end
function Yule_IsConvoySquad(squad)
    local santa=YULE.santa
    if santa==nil then return false end
    local id=Squad_GetID(squad)
    if SGroup_ContainsSquad(santa.group,id,false) then return true end
    for _,member in ipairs(santa.members) do
        if SGroup_ContainsSquad(member.group,id,false) then return true end
    end
    return false
end
function Yule_Flight()
    local santa=YULE.santa
    if santa==nil or not YULE.running or SGroup_CountSpawned(santa.group)==0 then return end
    santa.position=SGroup_GetPosition(santa.group)
end
-- Scale separation to the map, not to the number or position of players.
function Yule_DropSpacing()
    local w,h=Yule_ConvoyBounds()
    return math.max(24,math.min(80,math.min(w,h)*0.3))
end
function Yule_DropAreaClear(position,players)
    if position==nil then return false end
    if World_GetTerrainCellType(position.x,position.z)~=1 then return false end
    local spacing=Yule_DropSpacing()^2
    for _,present in ipairs(YULE.presents or {}) do
        if (position.x-present.position.x)^2+(position.z-present.position.z)^2<spacing then return false end
    end
    -- Collected/expired presents still count for the remainder of this visit.
    for _,site in ipairs(YULE.santa and YULE.santa.dropSites or {}) do
        if (position.x-site.x)^2+(position.z-site.z)^2<spacing then return false end
    end
    local nearby=EGroup_CreateIfNotFound("yule_drop_clearance")
    local blocked=false
    for _,player in ipairs(players) do
        EGroup_Clear(nearby)
        Player_GetAllEntitiesNearMarker(player.id,nearby,position,6)
        EGroup_ForEach(nearby,function(gid,idx,entity)
            if Entity_IsOfType(entity,AGS_BP_BUILDING) then blocked=true end
        end)
    end
    return not blocked
end
function Yule_FindDeliveryArea(players)
    for attempt=1,64 do
        local position=Yule_RandomMapPosition()
        if position==nil then return nil end
        if Yule_DropAreaClear(position,players) then return position end
    end
    return nil
end
function Yule_UpdateVisit(players)
    local santa=YULE.santa
    if santa==nil then return end
    if SGroup_CountSpawned(santa.group)==0 then Yule_EndVisit(); return end
    -- Unavailable gift sites may extend a visit; never end below its 8-12 target.
    if YULE.time>=santa.ends and santa.drops>=santa.dropTarget then Yule_EndVisit(); return end
    if YULE.time<santa.nextDrop then return end
    if santa.drops>=santa.dropTarget then return end
    santa.position=SGroup_GetPosition(santa.group)
    -- Each gift independently samples the whole map. The convoy is visual:
    -- following its path must not lead a player to the remaining presents.
    -- Keep spacing history even when gifts are collected immediately.
    for attempt=1,8 do
        local position=Yule_FindDeliveryArea(players)
        if position==nil then break end
        local dropped,actual=Yule_DropPresent(position,players)
        if dropped then
            santa.drops=santa.drops+1
            table.insert(santa.dropSites,actual)
            print("Yuletide visit "..YULE.visits.." present "..santa.drops.."/"..santa.dropTarget.." at "..actual.x..","..actual.z)
            santa.nextDrop=YULE.time+World_GetRand(YULE_CONFIG.dropMin,YULE_CONFIG.dropMax)
            return
        end
    end
    santa.nextDrop=YULE.time+1
end
